# Copy to .env (gitignored) and fill in.
DATA_BACKEND=mock            # mock | postgres
DATABASE_URL=                # postgresql://user:pass@host:port/db (use a SELECT-only role)
LLM_API_KEY=                 # provider key (Google AI Studio for Gemini); GEMINI_API_KEY also works
AGENT_MODEL=gemini-2.5-flash # required: Gemini model id
GUARDRAIL_MODEL=             # optional: defaults to AGENT_MODEL
# LLM_BASE_URL=              # defaults to Gemini's OpenAI-compatible endpoint
# ALLOWED_ORIGINS=["http://localhost:5173"]   # JSON list of browser origins; ["*"] opens it up
# STATS_TTL_S=300            # seconds to cache Postgres cohort stats
