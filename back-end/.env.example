# Copy to .env (gitignored) and fill in.
DATA_BACKEND=mock            # mock | postgres
DATABASE_URL=                # postgresql://user:pass@host:port/db (read-only role recommended)
GEMINI_API_KEY=              # Google AI Studio key
AGENT_MODEL=gemini-2.5-flash # required: Gemini model id
GUARDRAIL_MODEL=             # optional: defaults to AGENT_MODEL
