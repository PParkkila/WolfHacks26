# Copy to .env (gitignored) and fill in.

# --- LLM (Gemini through its OpenAI-compatible endpoint) ---
GEMINI_API_KEY=                 # or LLM_API_KEY
AGENT_MODEL=gemini-2.5-flash    # required
# GUARDRAIL_MODEL=              # defaults to AGENT_MODEL
# LLM_BASE_URL=                 # defaults to Gemini's OpenAI-compatible endpoint

# --- Data: Tiger (read-only role). Unset PGHOST/DATABASE_URL -> seeded mock data ---
# DATA_BACKEND=postgres         # mock | postgres; default picks postgres if configured
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
# DATABASE_URL=                 # alternative to the PG* variables
DEMO_SESSION_ID=                # dashboard session to read, e.g. continuous-oct4-v1; empty = newest published
# STORE_REFRESH_S=5             # how often newly published analytics windows are picked up
# LIVE_REFRESH_S=1              # how often the live sensor readings (gold.dashboard_live) are re-read

# --- Replay clock: walks through the data so the demo looks live ---
# Set REPLAY_ENABLED=false for a continuous (live) session such as continuous-oct4-v1.
# REPLAY_ENABLED=true           # false: always show everything up to the newest window
# REPLAY_START=                 # ISO time; default is one day after the first window
# REPLAY_SECONDS_PER_HOUR=5     # real seconds per simulated hour

# --- Demo login ---
# AUTH_SECRET=                  # signs login tokens; set a long random value
# TOKEN_TTL_HOURS=24

# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]   # JSON list of browser origins
